[Unit]
Description=Raspberry Pi computer statistics display
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/neonlightning/statsdisplay
ExecStart=/usr/bin/python3 /home/neonlightning/statsdisplay/display_client.py --url http://192.168.1.53:8282/stats --display-driver framebuffer --fbdev /dev/fb1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
